<UserControl x:Class="TimeDial_Test.TimeDial"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TimeDial_Test"
             mc:Ignorable="d" 
             d:DesignHeight="30" d:DesignWidth="100" x:Name="root" >

    <Grid>


        <!--<Border x:Name="Border" Padding="10" CornerRadius="10" Background="White" Width="100" Height="270" Margin="0,-120,0,-120" VerticalAlignment="Center">

            <Border.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#44FFFFFF" Offset="0"/>


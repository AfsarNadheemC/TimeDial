<Window x:Class="TimeDial_Test.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TimeDial_Test"
        xmlns:td="clr-namespace:TimeDialControl"
        mc:Ignorable="d"
        Title="MainWindow" Height="533" Width="300" 
        Background="Navy" Topmost="True" x:Name="root">

    <Grid DataContext="{Binding ElementName=root}">
        <td:TimeDial x:Name="TimeDial" Hour="{Binding Hour , Mode=OneWayToSource}" Minute="{Binding Minute , Mode=OneWayToSource}" Is24HourFormat="False"/>

        <Button VerticalAlignment="Bottom"  Content="Check" Click="Button_Click_1" />

    </Grid>
</Window>
